# --- HTTP ---
PORT=3000

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Namespaces queue keys. Set explicitly to share queues across processes;
# leaving it blank defaults to workflow:<pid>, which isolates each dev session.
REDIS_QUEUE_PREFIX=

# --- Kubernetes ---
KUBE_NAMESPACE=kubedag-runner
KUBE_POD_LABEL=app=runner
RUNNER_REPLICAS=7

# --- Liveness ---
# How often a running step pulses. Also the granularity of liveness detection.
HEARTBEAT_INTERVAL_MS=10000
# Missed pulses tolerated before a step is declared dead. The effective
# timeout is interval x grace, so both are tunable.
HEARTBEAT_GRACE_BEATS=3
LIVENESS_SCAN_INTERVAL_MS=5000

# --- Execution (kubedag extensions over the reference architecture) ---
# Per-step execution timeout. Independent of heartbeats on purpose: a hung
# command inside a healthy pod heartbeats forever and is only caught here.
DEFAULT_STEP_TIMEOUT_MS=300000
MAX_STEP_TIMEOUT_MS=1800000
# Work performed between leases to stop one step affecting the next.
CLEANUP_TIMEOUT_MS=15000
# Bounds captured output per stream.
MAX_LOG_BYTES=65536

# --- Concurrency ---
GLOBAL_MAX_CONCURRENT_STEPS=20
PER_RUN_MAX_CONCURRENT_STEPS=8

# --- Limits (untrusted input) ---
MAX_WORKFLOW_BYTES=262144
MAX_STEPS_PER_WORKFLOW=500
MAX_COMMAND_BYTES=4096
MAX_STEP_ID_LEN=128
